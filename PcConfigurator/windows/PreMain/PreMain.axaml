<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:win32="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        win32:Win32Properties.WindowCornerPreference="Round"
        mc:Ignorable="d" d:DesignWidth="1168" d:DesignHeight="784"
        x:Class="PcConfigurator.windows.PreMain.PreMain">

        <Grid>
          <Border BorderBrush="#333232"
                  BorderThickness="4" 
                  CornerRadius="5" 
                  Padding="20">

            <StackPanel Spacing="20">
              <Label HorizontalAlignment="Center">Введите данные для подключения к БД</Label>
              
              <Label HorizontalAlignment="Left">Ip сервера</Label>
              <TextBox Name="Server"></TextBox>
                <Label HorizontalAlignment="Left">Порт</Label>
              <TextBox Name="Port"></TextBox>
                <Label HorizontalAlignment="Left">Имя БД</Label>
              <TextBox Name="DbName"></TextBox>
                <Label HorizontalAlignment="Left">Имя пользовотеля</Label>
              <TextBox Name="Username"></TextBox>
                <Label HorizontalAlignment="Left">Пароль</Label>
              <TextBox Name="Password"></TextBox>

              <Button HorizontalAlignment="Center" Name="Connect" Click="ConnectHandler">ПОДКЛЮЧИТЬСЯ</Button>
              <Label Name="Status" Background="#E66565" HorizontalAlignment="Center">Не подключено</Label>
            </StackPanel>

          </Border>
        </Grid>
</Window>
