<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:win32="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        win32:Win32Properties.WindowCornerPreference="Round"
        mc:Ignorable="d" d:DesignWidth="1168" d:DesignHeight="784"
        x:Class="PcConfigurator.PreMain">

        <Grid>
          <Border BorderBrush="#333232"
                  BorderThickness="4" 
                  CornerRadius="5" 
                  Padding="20">

            <StackPanel Spacing="20">
              <Label HorizontalAlignment="Center">Введите URL для подключения к БД</Label>
              <TextBox Name="DbURL"></TextBox>
              <Button HorizontalAlignment="Center">ПОДКЛЮЧИТЬСЯ</Button>
            </StackPanel>

          </Border>
        </Grid>
</Window>
