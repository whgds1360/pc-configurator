<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:win32="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        win32:Win32Properties.WindowCornerPreference="Round"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="PcConfigurator.windows.SaveConfiguration.SaveConfigurationWindow"
        Title="PС Configurator"
        Width="600"
        Height="400"
        CanResize="False">

        <StackPanel Margin="20" Spacing="20">
          <Label HorizontalAlignment="Center">Введите имя конфигурации</Label>
          <TextBox></TextBox>
          <Button HorizontalAlignment="Center">Сохранить</Button>
          <Button HorizontalAlignment="Center">Отменить</Button>
        </StackPanel>
</Window>
