<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:win32="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        xmlns:local="using:PcConfigurator.windows.Admin"
        win32:Win32Properties.WindowCornerPreference="Round"
        mc:Ignorable="d" d:DesignWidth="1168" d:DesignHeight="784"
        x:Class="PcConfigurator.windows.Admin.AdminWindow"
        x:DataType="local:AdminWindow"
        Title="Admin"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Label.DbInfo">
            <Setter Property="FontSize" Value="20"></Setter>
        </Style>
    </Window.Styles>

    <StackPanel Spacing="15">
        <StackPanel>
            <Label FontSize="50" HorizontalAlignment="Center">|АДМИН ПАНЕЛЬ|</Label>
        </StackPanel>

        <StackPanel Spacing="40" Margin="50">
        <StackPanel>
            <ItemsControl x:Name="DbInfoList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:DbInfoTemplate">
                        <StackPanel Orientation="Horizontal">
                            <Label Classes="DbInfo" Width="220" Content="{Binding Key}"/>
                            <Label Classes="DbInfo" Content="{Binding Value}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="50" HorizontalAlignment="Center">
                <Button FontSize="30">Добавить запись</Button>
                <Button FontSize="30">Удалить запись</Button>
            </StackPanel>

            <ComboBox ItemsSource="{Binding TablesName}"
                SelectedItem="{Binding SelectTable}"
                SelectionChanged="ChangedTableHandler" 
                IsVisible="true" 
                MaxDropDownHeight="50" 
                MinWidth="250">
            </ComboBox>

            <ItemsControl x:Name="PropertyList">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="5"></WrapPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PropetryListTemplate">
                        <StackPanel>
                            <Label Content="{Binding Name}" Tag = "{Binding Tag}" FontSize="10"></Label>
                            <TextBox Tag="{Binding Tag}" PlaceholderText="Введите новое значение" FontSize="10"></TextBox>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </StackPanel>
    </StackPanel>

</Window>
