<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:win32="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        win32:Win32Properties.WindowCornerPreference="Round"
        mc:Ignorable="d" d:DesignWidth="1168" d:DesignHeight="784"
        x:Class="PcConfigurator.windows.Admin.AdminWindow"
        Title="Admin">

    <DockPanel Margin="16">

        <StackPanel DockPanel.Dock="Bottom" Spacing="15">
            <TextBlock x:Name="StatusText" Text="Готово"/>
            
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="Сохранить"/>
                <Button x:Name="ResetButton" Content="Сбросить"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="Лимит токенов"/>
            <TextBox x:Name="MaxTokensBox"/>

            <TextBlock Text="Температура ответов AI"/>
            <TextBox x:Name="TemperatureBox"/>
        </StackPanel>

    </DockPanel>
</Window>
