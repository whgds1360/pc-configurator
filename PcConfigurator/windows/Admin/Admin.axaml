<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:win32="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        win32:Win32Properties.WindowCornerPreference="Round"
        mc:Ignorable="d" d:DesignWidth="1168" d:DesignHeight="784"
        x:Class="PcConfigurator.windows.Admin.AdminWindow"
        Title="Admin"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Label.DbInfo">
            <Setter Property="FontSize" Value="20"></Setter>
        </Style>
    </Window.Styles>

    <StackPanel Spacing="100" Margin="50">
        <StackPanel>
            <Label FontSize="50" HorizontalAlignment="Center">|Админ панель|</Label>
            
            <Label FontSize="40">Информация о БД:</Label>

            <StackPanel Orientation="Horizontal">
                <Label Classes="DbInfo">Версия сервера:</Label>
                <Label Classes="DbInfo">Maria DB v2.3</Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Classes="DbInfo">iP адрес:</Label>
                <Label Classes="DbInfo">localhost</Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Classes="DbInfo">Порт:</Label>
                <Label Classes="DbInfo">3306</Label>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Classes="DbInfo">Подключено как:</Label>
                <Label Classes="DbInfo">root</Label>
            </StackPanel>

        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="50" HorizontalAlignment="Center">
            <Button FontSize="30">Добавить запись</Button>
            <Button FontSize="30">Удалить запись</Button>
        </StackPanel>
    </StackPanel>

</Window>
