<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:win32="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        win32:Win32Properties.WindowCornerPreference="Round"
        mc:Ignorable="d" d:DesignWidth="1168" d:DesignHeight="784"
        x:Class="PcConfigurator.MainWindow"
        Title="Pc Configurator"
        Width="1168"
        Height="784"
        CanResize="False">

        <Canvas Background="#1a1f25">
            <StackPanel Orientation="Horizontal" Spacing="100">
                <Button FontSize="50">[ Новая конфигурация ]</Button>
                <Button FontSize="50">[ Удалить ]</Button>
            </StackPanel>

        </Canvas>
</Window>
