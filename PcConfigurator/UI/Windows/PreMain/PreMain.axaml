<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:PcConfigurator.Ui.Windows.PreMain.ControlTemplates"
        mc:Ignorable="d" d:DesignWidth="1168" d:DesignHeight="784"
        x:Class="PcConfigurator.Ui.Windows.PreMain.PreMainWindow">

        <Grid>

          <Border BorderBrush="#333232"
                  BorderThickness="4" 
                  CornerRadius="5" 
                  Padding="20">

            <StackPanel Spacing="20">
              <Label HorizontalAlignment="Center">Введите данные для подключения к БД</Label>

              <ItemsControl x:Name="ConnectProperties">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:DbProperties">
                    <StackPanel>
                      <Label Content="{Binding Title}"/>
                      <TextBox Tag = "{Binding Tag}" Text="{Binding Value, Mode=TwoWay}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button HorizontalAlignment="Center" Click="ConnectHandler">ПОДКЛЮЧИТЬСЯ</Button>
              <Label Name="StatusBar" Background="#E66565" HorizontalAlignment="Center">Не подключено</Label>
            </StackPanel>
          </Border>

        </Grid>
</Window>
