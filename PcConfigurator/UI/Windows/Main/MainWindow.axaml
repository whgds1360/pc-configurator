<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:win32="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        win32:Win32Properties.WindowCornerPreference="Round"
        mc:Ignorable="d" d:DesignWidth="1168" d:DesignHeight="784"
        x:Class="PcConfigurator.Windows.Main.MainWindow">

        <Window.Styles>
            <StyleInclude Source="Styles.axaml"></StyleInclude>
        </Window.Styles>

        <Grid RowDefinitions="120, *, 200" RowSpacing="30" Background="#1a1f25">
            
            <Border Grid.Row="0">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Click="CreateHandler">[ Новая конфигурация ]</Button>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="DeleteHandler">[ Удалить ]</Button>
                </DockPanel>
            </Border>
            
            <StackPanel Grid.Row="1">
                <Label FontSize="30">Сохраненные сборки:</Label>

                <Border MaxHeight="330">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20" Name="Configuration">
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>

        </Grid>
</Window>
